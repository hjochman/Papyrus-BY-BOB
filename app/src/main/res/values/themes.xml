<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PapyrusEx" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@drawable/bg_papyrus</item>
        <item name="android:listDivider">@drawable/divider_line</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.Papyrus.Popup</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Papyrus.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Papyrus.Dialog</item>
    </style>

    <!-- Dialoge (u. a. Einstellungen) im gleichen Farbschema wie das Menü -->
    <style name="ThemeOverlay.Papyrus.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/papyrus_header</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="android:colorBackground">@color/papyrus_header</item>
        <item name="android:colorBackgroundFloating">@color/papyrus_header</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <!-- Gemeinsames Farbschema für das Overflow-Menü und das Long-Press-Menü der Liste -->
    <style name="ThemeOverlay.Papyrus.Popup" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="popupMenuStyle">@style/Widget.Papyrus.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Papyrus.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Papyrus.PopupMenu</item>
    </style>

    <style name="Widget.Papyrus.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/papyrus_header</item>
    </style>

    <style name="TextAppearance.Papyrus.PopupMenu" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textColor">@color/primary_text</item>
    </style>
</resources>
